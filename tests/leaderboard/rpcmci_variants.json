    " ",
    "         def _pcmci(tau_min, tau_max, pc_alpha, alpha_level):",
    "             \"\"\"Wrapper around running PCMCI.\"\"\"",
    "-            results = self.run_pcmci(tau_min=tau_min, tau_max=tau_max, pc_alpha=pc_alpha, alpha_level=alpha_level)",
    "+            test = self.cond_ind_test",
    "+            cache_enabled = (",
    "+                type(self) is RPCMCI and type(test) is ParCorr",
    "+                and test.significance == 'analytic' and test.confidence is None",
    "+                and test.verbosity == 0 and self.dataframe.bootstrap is None",
    "+                and type(self.dataframe) is DataFrame",
    "+                and 'run_test' not in vars(test)",
    "+            )",
    "+            original_run_test = test.run_test",
    "+            request_cache = {}",
    "+",
    "+            def cached_run_test(X, Y, Z=None, tau_max=0,",
    "+                                cut_off='2xtau_max', alpha_or_thres=None):",
    "+                x_nodes, y_nodes, z_nodes = tuple(X), tuple(Y), tuple(Z or ())",
    "+                # Only requests already in construct_array's canonical node form",
    "+                # can restore ci_results without repeating array construction.",
    "+                clean = (len(x_nodes) == len(y_nodes) == 1",
    "+                         and len(set(z_nodes)) == len(z_nodes)",
    "+                         and not set(z_nodes).intersection(x_nodes + y_nodes)",
    "+                         and not self.dataframe.has_vector_data)",
    "+                if not clean:",
    "+                    return original_run_test(X, Y, Z, tau_max, cut_off,",
    "+                                             alpha_or_thres)",
    "+                key = (x_nodes, y_nodes, z_nodes, tau_max, cut_off, alpha_or_thres)",
    "+                if key in request_cache:",
    "+                    result, ci_result, used_indices = request_cache[key]",
    "+                    test.ci_results[(x_nodes, y_nodes, z_nodes)] = ci_result",
    "+                    self.dataframe.use_indices_dataset_dict = deepcopy(used_indices)",
    "+                    return result",
    "+                result = original_run_test(X, Y, Z, tau_max, cut_off, alpha_or_thres)",
    "+                request_cache[key] = (",
    "+                    result, test.ci_results[(x_nodes, y_nodes, z_nodes)],",
    "+                    deepcopy(self.dataframe.use_indices_dataset_dict))",
    "+                return result",
    "+",
    "+            if cache_enabled:",
    "+                test.run_test = cached_run_test",
    "+            try:",
    "+                results = self.run_pcmci(tau_min=tau_min, tau_max=tau_max,",
    "+                                         pc_alpha=pc_alpha, alpha_level=alpha_level)",
    "+            finally:",
    "+                if cache_enabled:",
    "+                    del test.run_test",
    "             graph = results['graph'] ",
    "             pcmci_parents = self.return_parents_dict(graph=graph, val_matrix=results['val_matrix'])",
    "             return results, graph, pcmci_parents"
