    "+                    constraint.SetCoefficient(left, 1.0)",
    "+                    constraint.SetCoefficient(eta, -1.0)",
    "+",
    "+                    constraint = solver.RowConstraint(-infinity, upper_bound, \"\")",
    "+                    for eta_variable in eta_variables:",
